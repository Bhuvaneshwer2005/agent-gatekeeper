# Copy this file to .env and fill in real values. Never commit .env itself.

# Razorpay test-mode API credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# API key for whichever LLM provider is used to generate upsell justifications.
# The LLM only ever proposes/explains upsells after the deterministic validator
# has already approved a mandate — it never makes the approve/deny decision.
LLM_API_KEY=

# Local server port
PORT=8000
