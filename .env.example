# Copy this file to .env and fill in real values. Never commit .env itself.

# Razorpay test-mode API credentials (from the Razorpay dashboard, in Test
# Mode — these never move real money). Used by
# backend/app/razorpay_client/checkout.py to create test-mode orders for
# transactions the deterministic validator has already approved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Groq API key used to generate upsell justifications (free key from
# https://console.groq.com). The LLM only ever proposes/explains upsells
# after the deterministic validator has already approved a mandate — it
# never makes the approve/deny decision itself.
GROQ_API_KEY=

# Optional: override the default Groq model used for upsell proposals
# (see backend/app/upsell/llm_client.py for the default).
GROQ_MODEL=

# Local server port
PORT=8000
